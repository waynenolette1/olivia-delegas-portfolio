---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects, img } from '../data/projects';

const pad = (n: number) => String(n + 1).padStart(2, '0');

// A wall of finished pieces, drawn from across the portfolio, to show range at a glance.
const wallA = [
  { src: img('nec-athletics', 43), alt: 'Match Day wrestling graphic', slug: 'nec-athletics' },
  { src: img('futura-type-specimen', 32), alt: 'Futura! anatomy spread', slug: 'futura-type-specimen' },
  { src: img('wrestle-like-a-girl', 70), alt: 'All Heart poster', slug: 'wrestle-like-a-girl' },
  { src: img('espresso-yourself', 28), alt: 'Espresso Yourself! cans', slug: 'espresso-yourself' },
  { src: img('skipittechnology', 63), alt: 'SkipIt three-step social graphic', slug: 'skipittechnology' },
  { src: img('poster-design', 55), alt: 'Mint information poster', slug: 'poster-design' },
  { src: img('ymca-camp-massapoag', 91), alt: 'Campers jumping off the dock', slug: 'ymca-camp-massapoag' },
];
const wallB = [
  { src: img('vector-illustration', 64), alt: 'Vector portrait poster', slug: 'vector-illustration' },
  { src: img('artkitect-magazine', 15), alt: 'Artkitect feature spread', slug: 'artkitect-magazine' },
  { src: img('nec-athletics', 50), alt: 'Fall Festival graphic', slug: 'nec-athletics' },
  { src: img('kiwi-app-interface', 39), alt: 'Kiwi app screens', slug: 'kiwi-app-interface' },
  { src: img('wrestle-like-a-girl', 69), alt: 'Wrestle Like a Girl poster', slug: 'wrestle-like-a-girl' },
  { src: img('centerforbiologicaldiversity', 17), alt: 'CBD frog logo', slug: 'centerforbiologicaldiversity' },
  { src: img('futura-type-specimen', 34), alt: 'Futura! moon spread', slug: 'futura-type-specimen' },
];
const titleOf = (slug: string) => projects.find((p) => p.slug === slug)!.title;
---
<Base>
  <section class="hero wrap" aria-labelledby="intro">
    <div class="lead">
      <p class="label kicker" data-reveal>Graphic designer · Boston, Massachusetts</p>
      <h1 id="intro" class="statement" data-reveal style="--d:.08s">
        <span class="name">Olivia Delegas</span> is a graphic designer specializing in branding, marketing, and <span class="serif">visual storytelling.</span>
      </h1>

      <div class="index-head" data-reveal style="--d:.16s">
        <h2 class="label" id="work">Selected work</h2>
        <span class="label count">{String(projects.length).padStart(2, '0')} projects</span>
      </div>

      <ol class="index" data-index aria-labelledby="work">
        {projects.map((p, i) => (
          <li data-reveal style={`--d:${0.2 + i * 0.035}s`}>
            <a
              href={`/work/${p.slug}`}
              class="row"
              data-i={i}
              data-color={p.color}
              data-ink={p.ink}
              data-tint={p.tint}
              style={`--c:${p.color}`}
            >
              <span class="n">{pad(i)}</span>
              <span class="t">{p.title}</span>
              <span class="k">{p.kind}</span>
              <span class="go" aria-hidden="true">→</span>
              <span class="m-cover" aria-hidden="true" style={`--bg:${p.color}`}>
                <Image
                  src={p.cover.src}
                  alt=""
                  widths={[480, 760, 1100]}
                  sizes="100vw"
                  loading="lazy"
                  transition:name={`cover-${p.slug}`}
                />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="stage-col" aria-hidden="true">
      <div class="stage" data-stage>
        {projects.map((p, i) => (
          <a
            href={`/work/${p.slug}`}
            class:list={['shot', { on: i === 0 }]}
            data-shot={i}
            tabindex="-1"
            style={`--bg:${p.color}`}
          >
            <Image
              src={p.cover.src}
              alt=""
              widths={[640, 960, 1280, 1700]}
              sizes="(min-width: 1000px) 46vw, 1px"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              transition:name={`cover-${p.slug}`}
            />
          </a>
        ))}
        <div class="stage-cap">
          <span class="label" data-cap-n>01</span>
          <span data-cap-k>{projects[0].kind}</span>
          <span class="progress"><i data-progress></i></span>
        </div>
      </div>
    </div>
  </section>

  <section class="belief" aria-labelledby="belief-title">
    <div class="wrap belief-grid">
      <p class="label" id="belief-title" data-reveal>Philosophy</p>
      <blockquote data-reveal style="--d:.06s">
        <p>
          “I believe strong design goes beyond aesthetics; it <span class="serif">communicates a message,</span> <span class="serif">establishes an identity,</span> and <span class="serif">creates a lasting impression.</span>”
        </p>
      </blockquote>
      <div class="belief-meta" data-reveal style="--d:.12s">
        <p>My design philosophy centers around visual storytelling and using design as a tool to create meaningful connections between brands and their audiences.</p>
        <a href="/about" class="more">More about Olivia <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="range" aria-labelledby="range-title">
    <div class="wrap range-head">
      <h2 id="range-title" class="display" data-reveal>Across print, digital, <span class="serif">motion</span> and the camera.</h2>
      <p class="range-list" data-reveal style="--d:.08s">Branding · Editorial · Typography · Illustration · Social · UI and UX · Motion · Photography</p>
    </div>
    <div class="wall" data-wall>
      {[wallA, wallB].map((row, r) => (
        <div class:list={['wall-row', r ? 'rev' : '']}>
          <div class="wall-track">
            {[...row, ...row].map((w, k) => (
              <a href={`/work/${w.slug}`} class="tile" tabindex={k >= row.length ? -1 : undefined} aria-hidden={k >= row.length ? 'true' : undefined}>
                <Image src={w.src} alt={k >= row.length ? '' : `${w.alt}, from ${titleOf(w.slug)}`} widths={[360, 560, 800]} sizes="(min-width: 800px) 22vw, 52vw" loading="lazy" />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  /* ---------- hero + index ---------- */
  :global(html body) { background: var(--wash, var(--paper)); transition: background-color 1.1s var(--ease-out); }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: clamp(32px, 5vw, 96px);
    padding-top: clamp(120px, 15vh, 168px);
    padding-bottom: clamp(64px, 10vw, 140px);
  }
  .kicker { color: var(--ink-2); margin-bottom: clamp(18px, 2.4vw, 28px); }
  .statement {
    font-size: clamp(2.1rem, 1.2rem + 2.9vw, 4.35rem);
    font-weight: 450; letter-spacing: -0.032em; line-height: 1.02;
    max-width: 15.5em; text-wrap: balance;
  }
  .statement .name { color: var(--teal); font-weight: 560; }
  .statement .serif { font-size: 1.1em; letter-spacing: -0.015em; line-height: 0.9; }

  .index-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-top: clamp(48px, 8vh, 96px); padding-bottom: 14px; border-bottom: 1px solid var(--ink);
  }
  .index-head .count { color: var(--ink-3); }

  .row {
    display: grid; grid-template-columns: 3.1em minmax(0, 1fr) auto 1.4em; align-items: baseline;
    gap: 0 16px; padding: 15px 0 14px; border-bottom: 1px solid var(--line);
    position: relative; isolation: isolate;
  }
  .row::before {
    content: ''; position: absolute; inset: 0 calc(-1 * min(var(--gutter), 20px)); z-index: -1;
    background: var(--c); transform: scaleY(0); transform-origin: bottom;
    transition: transform 0.55s var(--ease-out);
  }
  .n { font-size: var(--step--1); font-variant-numeric: tabular-nums; color: var(--ink-3); letter-spacing: 0.06em; transition: color 0.3s; }
  .t { font-size: clamp(1.35rem, 1rem + 1.1vw, 2.15rem); font-weight: 450; letter-spacing: -0.025em; line-height: 1.1; transition: transform 0.55s var(--ease-out); }
  .k { font-size: var(--step--1); color: var(--ink-2); text-align: right; transition: color 0.3s; }
  .go { color: var(--ink); opacity: 0; transform: translateX(-8px); transition: opacity 0.35s, transform 0.45s var(--ease-out); justify-self: end; }
  .row.is-active .n { color: var(--ink); }
  .row.is-active .t { transform: translateX(10px); }
  .row.is-active .go { opacity: 1; transform: none; }
  .row.is-active .k { color: var(--ink); }
  .row:focus-visible { outline-offset: -2px; }
  .m-cover { display: none; }

  .stage-col { position: relative; }
  .stage {
    position: sticky; top: 104px;
    aspect-ratio: 5 / 6; max-height: calc(100vh - 136px); width: 100%;
    margin-left: auto;
  }
  /* each piece is mounted whole on its own colour, like a print on a mat */
  .shot {
    position: absolute; inset: 0; overflow: hidden; background: var(--bg);
    display: grid; place-items: center; padding: clamp(24px, 9%, 72px) clamp(16px, 5%, 40px);
    clip-path: inset(100% 0 0 0);
  }
  .shot img {
    width: auto; height: auto; max-width: 100%; max-height: 100%; min-height: 0;
    box-shadow: 0 2px 4px rgba(0,0,0,.12), 0 28px 60px -24px rgba(0,0,0,.45);
    transform: translateY(6%) scale(1.04); transform-origin: 50% 100%;
  }
  .shot.on { clip-path: inset(0 0 0 0); transition: clip-path 1s var(--ease-io); }
  .shot.on img { transform: scale(1); transition: transform 1.6s var(--ease-out); }
  .shot.instant, .shot.instant img { transition: none !important; }
  .stage-cap {
    position: absolute; left: 0; right: 0; bottom: -40px; display: grid; grid-template-columns: auto 1fr auto; gap: 14px;
    align-items: center; font-size: var(--step--1); color: var(--ink-2);
  }
  .progress { width: 72px; height: 1.5px; background: var(--line); overflow: hidden; }
  .progress i { display: block; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; }
  .progress i.run { animation: fill var(--dur, 3.4s) linear forwards; }
  @keyframes fill { to { transform: scaleX(1); } }
  .stage.paused .progress { opacity: 0; transition: opacity 0.4s; }

  /* ---------- philosophy ---------- */
  .belief { padding: clamp(80px, 12vw, 180px) 0; border-top: 1px solid var(--line); }
  .belief-grid { display: grid; grid-template-columns: 1fr 3fr; gap: 24px clamp(24px, 4vw, 64px); }
  .belief-grid > .label { color: var(--ink-2); padding-top: 0.9em; }
  blockquote p {
    font-size: var(--step-3); font-weight: 420; letter-spacing: -0.03em; line-height: 1.1; text-wrap: balance;
  }
  blockquote .serif { color: var(--teal); font-size: 1.08em; letter-spacing: -0.01em; }
  .belief-meta { grid-column: 2; display: grid; grid-template-columns: minmax(0, 32em) auto; align-items: end; gap: 24px 48px; margin-top: clamp(24px, 3vw, 40px); color: var(--ink-2); }
  .more { font-weight: 500; color: var(--ink); white-space: nowrap; border-bottom: 1px solid currentColor; padding-bottom: 3px; }

  /* ---------- range wall ---------- */
  .range { padding-bottom: clamp(80px, 11vw, 160px); overflow: hidden; }
  .range-head { display: flex; justify-content: space-between; align-items: end; gap: 24px 48px; flex-wrap: wrap; margin-bottom: clamp(32px, 4vw, 56px); }
  .range-head h2 { font-size: var(--step-3); max-width: 13em; }
  .range-head h2 .serif { color: var(--teal); }
  .range-list { color: var(--ink-2); max-width: 26em; font-size: var(--step--1); letter-spacing: 0.04em; }
  .wall { display: grid; gap: clamp(10px, 1.2vw, 18px); }
  .wall-row { overflow: hidden; }
  .wall-track { display: flex; gap: clamp(10px, 1.2vw, 18px); width: max-content; animation: drift 70s linear infinite; }
  .wall-row.rev .wall-track { animation-direction: reverse; animation-duration: 84s; }
  .wall:hover .wall-track, .wall:focus-within .wall-track { animation-play-state: paused; }
  .tile { flex: none; height: clamp(200px, 26vw, 400px); overflow: hidden; background: var(--paper-2); }
  .tile img { height: 100%; width: auto; transition: transform 0.9s var(--ease-out), filter 0.5s; }
  .tile:hover img { transform: scale(1.04); }
  @keyframes drift { to { transform: translateX(calc(-50% - clamp(5px, 0.6vw, 9px))); } }
  @media (prefers-reduced-motion: reduce) {
    .wall-row { overflow-x: auto; }
    .wall-track { animation: none; }
  }

  /* ---------- responsive ---------- */
  @media (hover: hover) and (min-width: 1000px) {
    .row:hover::before { transform: scaleY(0.04); }
  }
  @media (max-width: 999px) {
    .hero { grid-template-columns: 1fr; padding-top: 104px; }
    .stage-col { display: none; }
    .index-head { margin-top: 40px; }
    .row { grid-template-columns: 2.4em minmax(0, 1fr); padding: 18px 0 26px; border-bottom: 0; }
    .row::before { display: none; }
    .t { font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem); }
    .k { grid-column: 2; text-align: left; margin-top: 4px; }
    .go { display: none; }
    .row.is-active .t { transform: none; }
    .m-cover {
      display: block; grid-column: 1 / -1; order: -1; margin-bottom: 16px;
      aspect-ratio: 4 / 5; overflow: hidden; background: var(--bg);
    }
    .m-cover { display: grid; place-items: center; padding: 8%; }
    .m-cover img { width: auto; height: auto; max-width: 100%; max-height: 100%; min-height: 0; box-shadow: 0 2px 4px rgba(0,0,0,.12), 0 22px 44px -22px rgba(0,0,0,.45); transition: transform 1.2s var(--ease-out); }
    .row:active .m-cover img { transform: scale(0.985); }
    .belief-grid { grid-template-columns: 1fr; }
    .belief-grid > .label { padding-top: 0; }
    .belief-meta { grid-column: 1; grid-template-columns: 1fr; }
  }
  @media (min-width: 640px) and (max-width: 999px) {
    .m-cover { aspect-ratio: 4 / 3; }
  }
</style>

<script>
  function initIndex() {
    const index = document.querySelector<HTMLElement>('[data-index]');
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    if (!index || !stage) return;
    const rows = [...index.querySelectorAll<HTMLAnchorElement>('.row')];
    const shots = [...stage.querySelectorAll<HTMLElement>('.shot')];
    const capN = stage.querySelector<HTMLElement>('[data-cap-n]')!;
    const capK = stage.querySelector<HTMLElement>('[data-cap-k]')!;
    const bar = stage.querySelector<HTMLElement>('[data-progress]')!;
    const root = document.documentElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = matchMedia('(min-width: 1000px)');
    let current = -1;
    let tint = '';
    let heroOn = true;
    const hero = document.querySelector<HTMLElement>('.hero')!;
    const heroIO = new IntersectionObserver(([e]) => {
      heroOn = e.isIntersecting;
      if (heroOn && tint) root.style.setProperty('--wash', `color-mix(in oklab, ${tint} 70%, #f4f0e8)`);
      else root.style.removeProperty('--wash');
    }, { rootMargin: '0px 0px -55% 0px' });
    heroIO.observe(hero);
    let z = 2;

    const kinds = rows.map((r) => r.querySelector('.k')!.textContent || '');

    function show(i: number, opts: { instant?: boolean } = {}) {
      if (i === current) return;
      current = i;
      rows.forEach((r, k) => r.classList.toggle('is-active', k === i));
      tint = rows[i].dataset.tint!;
      if (heroOn) root.style.setProperty('--wash', `color-mix(in oklab, ${tint} 70%, #f4f0e8)`);
      if (!desktop.matches) return;
      const s = shots[i];
      s.classList.remove('on');
      s.classList.toggle('instant', !!opts.instant || reduce);
      void s.offsetWidth; // restart the wipe
      s.style.zIndex = String(++z);
      s.classList.add('on');
      capN.textContent = String(i + 1).padStart(2, '0');
      capK.textContent = kinds[i];
    }

    // autoplay: a slow tour of the work until the visitor takes over
    const DUR = 3400;
    let timer = 0;
    let auto = !reduce;
    function tick() {
      bar.classList.remove('run'); void bar.offsetWidth; bar.classList.add('run');
      timer = window.setTimeout(() => { show((current + 1) % rows.length); tick(); }, DUR);
    }
    function stopAuto() {
      if (!auto) return;
      auto = false; clearTimeout(timer); stage.classList.add('paused'); bar.classList.remove('run');
    }

    rows.forEach((r, i) => {
      r.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { stopAuto(); show(i); } });
      r.addEventListener('focus', () => { stopAuto(); show(i); });
    });
    stage.addEventListener('pointerenter', stopAuto);

    // Pause the tour when the stage is off-screen or the tab is hidden.
    let visible = true;
    const vis = new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (!auto) return;
      clearTimeout(timer);
      if (visible && !document.hidden) tick(); else bar.classList.remove('run');
    });
    if (desktop.matches) vis.observe(stage);
    const onVis = () => { if (!auto) return; clearTimeout(timer); if (!document.hidden && visible) tick(); };
    document.addEventListener('visibilitychange', onVis);

    // Mobile: the page takes on the colour of whichever project sits mid-screen.
    const mob = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) show(Number((e.target as HTMLElement).dataset.i));
    }, { rootMargin: '-45% 0px -45% 0px' });
    if (!desktop.matches) rows.forEach((r) => mob.observe(r));

    show(0, { instant: true });
    if (!desktop.matches || reduce) stage.classList.add('paused');

    document.addEventListener('astro:before-swap', () => {
      clearTimeout(timer); vis.disconnect(); mob.disconnect(); heroIO.disconnect();
      document.removeEventListener('visibilitychange', onVis);
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initIndex);
</script>
