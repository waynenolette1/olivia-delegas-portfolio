---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { projects, neighbours, type Project, type Shot } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props as { project: Project };
const { next, index } = neighbours(p.slug);
const n = (i: number) => String(i + 1).padStart(2, '0');
const ratio = (s: Shot) => s.src.width / s.src.height;
const W = { full: [800, 1200, 1600, 2200], half: [600, 900, 1300], third: [480, 720, 1000], album: [480, 720, 1000] };
const photos = p.blocks.reduce((t, b) => t + (b.kind === 'album' ? b.shots.length : 0), 0);
---
<Base
  title={p.title}
  description={p.lede}
  image={`/og/${p.slug}.jpg`}
  imageAlt={`${p.title}, ${p.kind.toLowerCase()} by Olivia Delegas.`}
  accent={p.color}
  accentInk={p.ink}
  accentTint={p.tint}
>
  <article class="project" style={`--c:${p.color};--ci:${p.ink};--ct:${p.tint}`}>
    <header class="p-hero">
      <div class="wrap">
        <div class="p-top">
          <a href="/#work" class="label back"><span class="arrow" aria-hidden="true">←</span> All work</a>
          <span class="label">{n(index)} / {n(projects.length - 1)}</span>
        </div>
        <p class="label p-kind">{p.kind}</p>
        <h1 class="p-title">{p.title}</h1>
        <div class="p-intro">
          <p class="lede">{p.lede}</p>
          <dl class="facts">
            {p.facts.map((f) => (
              <div><dt class="label">{f.label}</dt><dd>{f.value}</dd></div>
            ))}
            {photos > 0 && <div><dt class="label">Photographs</dt><dd>{photos} from the daily albums</dd></div>}
          </dl>
        </div>
      </div>
    </header>

    <div class="wrap p-cover-wrap">
      <figure class="p-cover" style={`--r:${p.cover.src.width / p.cover.src.height}`}>
        <button type="button" class="zoom" data-lb aria-label={`View larger: ${p.cover.alt}`}>
          <Image
            src={p.cover.src}
            alt={p.cover.alt}
            widths={W.full}
            sizes="(min-width: 1680px) 1550px, 92vw"
            loading="eager"
            fetchpriority="high"
            transition:name={`cover-${p.slug}`}
          />
        </button>
      </figure>
    </div>

    <div class="wrap p-body">
      {p.blocks.map((b) => {
        if (b.kind === 'text') return (
          <section class="b-text" data-reveal>
            {b.eyebrow && <h2 class="label">{b.eyebrow}</h2>}
            <div>{b.body.map((t) => <p>{t}</p>)}</div>
          </section>
        );
        if (b.kind === 'link') return (
          <p class="b-link" data-reveal>
            <a href={b.href} target="_blank" rel="noopener">
              <span class="t">{b.label}</span>
              {b.note && <span class="label">{b.note}</span>}
              <span class="arrow" aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </p>
        );
        if (b.kind === 'video') return (
          <figure class="b-video" data-reveal>
            <div class="vid">
              <video src={b.src} poster={b.poster} muted loop playsinline preload="metadata" data-autoplay aria-label={b.label}></video>
              <button type="button" class="vid-btn" data-vid-btn aria-label="Pause video">
                <span class="i-pause" aria-hidden="true"></span>
              </button>
            </div>
            {b.caption && <figcaption>{b.caption}</figcaption>}
          </figure>
        );
        if (b.kind === 'full') return (
          <figure class="b-full" data-reveal>
            <button type="button" class="zoom" data-lb aria-label={`View larger: ${b.shot.alt}`}>
              <Image src={b.shot.src} alt={b.shot.alt} widths={W.full} sizes="(min-width: 1680px) 1550px, 92vw" loading="lazy" />
            </button>
            {b.caption && <figcaption>{b.caption}</figcaption>}
          </figure>
        );
        if (b.kind === 'pair') return (
          <figure class="b-pair" data-reveal>
            {b.shots.map((s, k) => (
              <button type="button" class="zoom" data-lb style={`flex:${ratio(s)} 1 0%;--d:${k * 0.08}s`} aria-label={`View larger: ${s.alt}`}>
                <Image src={s.src} alt={s.alt} widths={W.half} sizes="(min-width: 760px) 46vw, 92vw" loading="lazy" />
              </button>
            ))}
          </figure>
        );
        if (b.kind === 'grid') return (
          <figure class:list={['b-grid', `cols-${b.cols}`]}>
            {b.shots.map((s, k) => (
              <button type="button" class="zoom" data-lb data-reveal style={`--d:${(k % b.cols) * 0.07}s`} aria-label={`View larger: ${s.alt}`}>
                <Image src={s.src} alt={s.alt} widths={W.third} sizes={`(min-width: 760px) ${Math.round(92 / b.cols)}vw, 92vw`} loading="lazy" />
              </button>
            ))}
          </figure>
        );
        if (b.kind === 'album') return (
          <section class="b-album">
            <div class="album-head" data-reveal>
              <h2 class="album-title">{b.title}</h2>
              {b.intro && <p>{b.intro}</p>}
            </div>
            <div class="album">
              {b.shots.map((s) => (
                <button type="button" class="zoom" data-lb data-reveal aria-label={`View larger: ${s.alt}`}>
                  <Image src={s.src} alt={s.alt} widths={W.album} sizes="(min-width: 1100px) 30vw, (min-width: 640px) 45vw, 46vw" loading="lazy" />
                </button>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <nav class="next" aria-label="Next project" style={`--nc:${next.color};--ni:${next.ink}`}>
      <a href={`/work/${next.slug}`} class="next-link">
        <span class="wrap next-inner">
          <span class="label">Next project · {n(projects.indexOf(next))}</span>
          <span class="next-title">{next.title}<span class="arrow" aria-hidden="true">→</span></span>
          <span class="next-kind">{next.kind}</span>
          <span class="next-thumb" aria-hidden="true">
            <Image src={next.cover.src} alt="" widths={[400, 700]} sizes="320px" loading="lazy" />
          </span>
        </span>
      </a>
    </nav>
  </article>
  <Lightbox />
</Base>

<style>
  :global(html body) { background: var(--accent-tint); }
  :global(.site-header.is-scrolled) { background: color-mix(in oklab, var(--accent-tint) 86%, transparent) !important; }
  :global(.site-header:not(.is-scrolled):not(.menu-open)), :global(.site-header:not(.is-scrolled):not(.menu-open) .mark) { color: var(--accent-ink); }

  .p-hero { background: var(--c); color: var(--ci); padding-top: clamp(100px, 13vh, 140px); padding-bottom: clamp(140px, 22vw, 320px); }
  .p-top { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid color-mix(in oklab, var(--ci) 35%, transparent); }
  .back:hover .arrow { transform: translateX(-0.28em); }
  .p-kind { margin-top: clamp(32px, 5vw, 72px); opacity: 0.8; }
  .p-title {
    margin-top: 14px; font-size: var(--step-5); font-weight: 520; letter-spacing: -0.05em; line-height: 0.9;
    max-width: 11em; text-wrap: balance;
    animation: rise 1s var(--ease-out) both 0.05s;
  }
  .p-intro { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 32px clamp(32px, 6vw, 112px); margin-top: clamp(32px, 4.5vw, 64px); animation: rise 1s var(--ease-out) both 0.15s; }
  .lede { font-size: var(--step-1); line-height: 1.42; letter-spacing: -0.01em; max-width: 34em; }
  .facts { display: grid; gap: 14px; align-content: start; }
  .facts > div { display: grid; grid-template-columns: 8.5em 1fr; gap: 12px; padding-top: 12px; border-top: 1px solid color-mix(in oklab, var(--ci) 28%, transparent); }
  .facts dt { opacity: 0.7; padding-top: 0.2em; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }

  .p-cover-wrap { margin-top: clamp(-260px, -18vw, -110px); }
  .p-cover { width: min(100%, calc(84vh * var(--r))); margin-inline: auto; box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.45); }
  .p-cover img { width: 100%; }

  .zoom { display: block; width: 100%; cursor: zoom-in; position: relative; overflow: hidden; background: color-mix(in oklab, var(--c) 18%, var(--ct)); }
  .zoom img { width: 100%; transition: transform 1.1s var(--ease-out); }
  .zoom:hover img { transform: scale(1.015); }

  .p-body { display: grid; gap: clamp(28px, 4vw, 64px); padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(80px, 12vw, 180px); }
  .b-full .zoom { width: fit-content; margin-inline: auto; }
  .b-full img { max-height: 92vh; width: auto; max-width: 100%; }
  figcaption { margin-top: 14px; font-size: var(--step--1); color: var(--ink-2); max-width: 40em; }
  .b-pair { display: flex; gap: clamp(12px, 2vw, 28px); align-items: flex-start; }
  .b-grid { display: grid; gap: clamp(12px, 2vw, 28px); }
  .b-grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .b-grid.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .b-text { display: grid; grid-template-columns: 1fr 2.2fr; gap: 16px clamp(24px, 4vw, 64px); padding: clamp(24px, 4vw, 56px) 0; }
  .b-text h2 { color: color-mix(in oklab, var(--ink) 70%, var(--c)); padding-top: 0.55em; }
  .b-text p { font-size: var(--step-2); line-height: 1.22; letter-spacing: -0.022em; max-width: 24em; text-wrap: pretty; }
  .b-text p + p { margin-top: 0.8em; }

  .b-link a {
    display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 20px;
    padding: 24px 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease-out), background-color 0.4s;
  }
  .b-link .t { font-size: var(--step-2); letter-spacing: -0.025em; font-weight: 450; }
  .b-link .arrow { font-size: var(--step-2); }
  .b-link a:hover { padding-inline: 18px; background: var(--c); color: var(--ci); }
  .b-link a:hover .arrow { transform: translate(0.12em, -0.12em); }

  .b-video .vid { position: relative; background: #6f95e2; }
  .b-video video { width: 100%; aspect-ratio: 16 / 9; }
  .vid-btn {
    position: absolute; right: 16px; bottom: 16px; width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.92); color: #111; display: grid; place-items: center;
  }
  .i-pause { width: 12px; height: 14px; border-inline: 4px solid currentColor; }
  .vid-btn.paused .i-pause { border: 0; width: 0; height: 0; border-left: 13px solid currentColor; border-block: 8px solid transparent; margin-left: 4px; }

  .b-album { margin-top: clamp(24px, 4vw, 64px); }
  .album-head { display: grid; grid-template-columns: 1fr 2.2fr; gap: 16px clamp(24px, 4vw, 64px); margin-bottom: clamp(28px, 4vw, 56px); padding-top: 28px; border-top: 1px solid var(--ink); }
  .album-title { font-size: var(--step-3); font-weight: 450; letter-spacing: -0.035em; line-height: 1; }
  .album-head p { font-size: var(--step-1); color: var(--ink-2); max-width: 30em; padding-top: 0.3em; }
  .album { columns: 3; column-gap: clamp(10px, 1.4vw, 20px); }
  @media (min-width: 1200px) { .album { columns: 4; } }
  .album .zoom { break-inside: avoid; margin-bottom: clamp(10px, 1.4vw, 20px); }

  /* page ending: the next project arrives in its own colour */
  .next { background: var(--nc); color: var(--ni); overflow: hidden; }
  .next-link { display: block; }
  .next-inner { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 12px 32px; padding-top: clamp(64px, 10vw, 140px); padding-bottom: clamp(64px, 10vw, 140px); position: relative; }
  .next-inner .label { grid-column: 1 / -1; opacity: 0.75; }
  .next-title { font-size: var(--step-5); font-weight: 520; letter-spacing: -0.05em; line-height: 0.9; display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.18em; max-width: 12em; }
  .next-title .arrow { font-size: 0.55em; }
  .next-link:hover .next-title .arrow { transform: translateX(0.2em); }
  .next-kind { grid-column: 1; opacity: 0.8; }
  .next-thumb {
    grid-column: 2; grid-row: 2 / span 2; width: clamp(140px, 18vw, 300px); aspect-ratio: 4 / 5; overflow: hidden;
    transform: translateY(14px) rotate(2deg); transition: transform 0.8s var(--ease-out); box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.5);
  }
  .next-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .next-link:hover .next-thumb { transform: translateY(0) rotate(0); }

  @media (max-width: 860px) {
    .p-intro { grid-template-columns: 1fr; }
    .b-text, .album-head { grid-template-columns: 1fr; }
    .b-text h2 { padding-top: 0; }
    .album { columns: 2; }
  }
  @media (max-width: 640px) {
    .b-pair { flex-direction: column; }
    .b-pair .zoom { flex: none !important; }
    .b-grid.cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .b-grid.cols-3 > :first-child:nth-last-child(odd) { grid-column: 1 / -1; }
    .facts > div { grid-template-columns: 7.5em 1fr; }
    .b-link a { grid-template-columns: 1fr auto; }
    .b-link .label { grid-row: 2; }
    .next-inner { grid-template-columns: 1fr; }
    .next-thumb { grid-column: 1; grid-row: auto; width: 46%; margin-top: 16px; }
    .p-cover { box-shadow: 0 18px 40px -26px rgba(0, 0, 0, 0.45); }
  }
</style>

<script>
  function initVideo() {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.b-video .vid').forEach((wrap) => {
      const v = wrap.querySelector('video')!;
      const btn = wrap.querySelector<HTMLButtonElement>('[data-vid-btn]')!;
      const sync = () => { const p = v.paused; btn.classList.toggle('paused', p); btn.setAttribute('aria-label', p ? 'Play video' : 'Pause video'); };
      let held = false;
      btn.addEventListener('click', () => { held = !v.paused; v.paused ? v.play() : v.pause(); });
      v.addEventListener('play', sync); v.addEventListener('pause', sync);
      if (!reduce) {
        new IntersectionObserver(([e]) => { if (e.isIntersecting) { if (!held) v.play().catch(sync); } else v.pause(); }, { threshold: 0.4 }).observe(v);
      }
      sync();
    });
  }
  document.addEventListener('astro:page-load', initVideo);
</script>
